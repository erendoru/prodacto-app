generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  TEAM
}

enum Platform {
  WEB
  MOBILE
  BOTH
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BacklogStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum MessageRole {
  USER
  ASSISTANT
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  fullName          String?   @map("full_name")
  avatarUrl         String?   @map("avatar_url")
  plan              Plan      @default(FREE)
  stripeCustomerId  String?   @unique @map("stripe_customer_id")
  monthlyQueryCount Int       @default(0) @map("monthly_query_count")
  queryResetAt      DateTime? @map("query_reset_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  projects        Project[]
  documents       Document[]
  backlogItems    BacklogItem[]
  marketAnalyses  MarketAnalysis[]
  chatMessages    ChatMessage[]

  @@map("users")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  description String?
  techStack   Json?    @map("tech_stack")
  platform    Platform @default(WEB)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    Document[]
  backlogItems BacklogItem[]
  chatMessages ChatMessage[]

  @@map("projects")
}

model Document {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  title        String
  content      String   @db.Text
  templateType String?  @map("template_type")
  aiScore      Json?    @map("ai_score")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model BacklogItem {
  id                 String        @id @default(uuid()) @db.Uuid
  projectId          String        @map("project_id") @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  title              String
  description        String?       @db.Text
  acceptanceCriteria Json?         @map("acceptance_criteria")
  readinessScore     Json?         @map("readiness_score")
  storyPoints        Int?          @map("story_points")
  priority           Priority      @default(MEDIUM)
  status             BacklogStatus @default(TODO)
  technicalRisks     Json?         @map("technical_risks")
  testScenarios      Json?         @map("test_scenarios")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("backlog_items")
}

model MarketAnalysis {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  productName String   @map("product_name")
  report      Json
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("market_analyses")
}

model ChatMessage {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  projectId String?     @map("project_id") @db.Uuid
  role      MessageRole
  content   String      @db.Text
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}
